<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="sale_order_create_rfq_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.create.rfq.wizard.form</field>
        <field name="model">sale.order.create.rfq.wizard</field>
        <field name="arch" type="xml">
            <form string="Create RFQ">
                <group>
                    <field name="sale_order_id" readonly="1"/>
                    <field name="boq_id" readonly="1"/>
                </group>
                
                <group>
                    <field name="select_all"/>
                </group>
                
                <field name="work_unit_line_ids">
                    <tree editable="bottom">
                        <field name="selected"/>
                        <field name="work_unit_id"/>
                        <!-- <field name="work_unit_code"/> -->
                        <field name="work_unit_name"/>
                        <field name="material_count"/>
                    </tree>
                </field>
                
                <footer>
                    <button string="Create RFQ" name="action_create_rfq" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_sale_order_create_rfq_wizard" model="ir.actions.act_window">
        <field name="name">Create RFQs</field>
        <field name="res_model">sale.order.create.rfq.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
