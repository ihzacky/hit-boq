<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_view_boq_adapter_po" model="ir.actions.act_window">
        <field name="name">Create Purchase Order</field>
        <field name="res_model">boq.adapter.po</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- Removed binding to boq.root since PO creation should be done at work unit level -->
    </record>

    <record id="view_boq_adapter_po_form" model="ir.ui.view">
        <field name="name">boq.adapter.po.form</field>
        <field name="model">boq.adapter.po</field>
        <field name="arch" type="xml">
            <form string="Create Purchase Order from BoQ">
                <p>
                    This action will create Purchase Order(s) for all purchasable materials and services in this BoQ.
                    <br/><br/>
                    Products will be grouped by the vendor specified on the product form. If any product is missing a vendor, the operation will be aborted.
                </p>
                <field name="boq_id" invisible="1"/>
                <footer>
                    <button name="action_create_po" type="object"
                            string="Confirm and Create PO(s)"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>